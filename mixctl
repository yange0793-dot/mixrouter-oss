// ---------------------------------------------------------------- backups
// mixrouter.js 每次改写客户端配置前都会 copyFileSync 一份 `.bak-mixui-<时间戳>-<随机>` 到同目录,
// 池子超出 BACKUP_KEEP 就按**纯字典序**删掉最前几个 —— 但从头到尾没有任何东西把这些备份列出来过,
// 所以"盘上到底有哪些、下一份备份会顶掉谁"一直只能靠手动 ls。backups 补的就是这一步。
//
// 这条命令是**只读**的:只 stat 与读目录项,不产生、不改写、不删除任何文件。真正的还原/写回是另一批的事,
// 所以这里既不提供也没有留任何写入路径(不新增 unlink/rename/copyFile 调用点)。
//
// 配置路径与 mixrouter.js 同源同默认值(那里是 CLAUDE_SETTINGS / CODEX_CONFIG 两个常量),
// 环境变量名也照抄 —— 测试靠它们把两处重定向到临时目录。这里读的只有**目录项**(备份文件名),
// 配置正文一个字节都不读:列备份池需要的就是文件名。
const BACKUPS_KEEP = backupView.BACKUPS_KEEP;  // = mixrouter.js BACKUP_KEEP(lib/config-backup.js 的 DEFAULT_KEEP)
const BACKUPS_MAX_BYTES = 512 * 1024;         // 差异预览的读回上限
// 用法串在 lib/cli/usage.js(与 EXPLAIN_USAGE、顶层总览同处维护;顶层那段必须收录这一段)
const backupsError = (code, message) => Object.assign(new Error(message), { code });

// 备份池目标表:**唯一**一份在 lib/backup/targets.js,/api/backups 也从那里取。
// 这里只把 root 与 home 交给它 —— root 必须用 mixctl 自己的 ROOT(`__dirname`,即仓库目录),
// 对应 mixrouter.js 的 `DATA_DIR = process.env.MIXR_DATA_DIR || ROOT`。
// ⚠ 这里曾经写成 `path.resolve(__dirname, '..')`,那是**仓库的父目录**,不是仓库目录:
//   默认路径(DATA_DIR 没被重定向)下会在父目录清点 providers.json 的备份池然后报"0 份",
//   而真备份躺在仓库目录里。测试全程设了 MIXR_DATA_DIR,所以它一次都没照出来。
//   targets.js 现在对 root 做绝对路径校验,但"绝对路径"本身挡不住指错目录 —— 所以这条靠
//   一条**默认路径**(不设 MIXR_DATA_DIR、只有 CLI 自身进程)的用例钉住。
function backupLocations() {
  return backupTargets({ root: ROOT, home: os.homedir(), env: process.env });
}

// --diff:与**一份指定备份**做差异预览。位置参数就是备份名(基名,或一个带路径的完整路径)。
// 现役文件默认由备份名推导,推不出来就报错;要覆盖用 `--file <现役路径>` 显式给。
// 重复给选项一律报错:静默取最后一个会让 `--file a --file b` 这种明显写错的调用看起来成功了。
function parseBackupsArgs(args) {
  const opts = { json: false, diff: false, base: null, file: null };
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === '--json') {
      if (opts.json) throw backupsError('invalid_arguments', '--json 不能重复');
      opts.json = true;
    } else if (arg === '--diff') {
      if (opts.diff) throw backupsError('invalid_arguments', '--diff 不能重复');
      opts.diff = true;
    } else if (arg === '--file') {
      if (opts.file !== null) throw backupsError('invalid_arguments', '--file 不能重复');
      const value = args[++i];
      if (!value || value.startsWith('--')) throw backupsError('invalid_arguments', '--file 缺少值');
      opts.file = value;
    } else if (arg === '--help' || arg === '-h') {
      opts.help = true;
    } else if (arg.startsWith('-')) {
      throw backupsError('invalid_arguments', `无法识别的 backups 选项: ${arg};仅支持 --json / --diff / --file / --help`);
    } else if (opts.base === null) {
      opts.base = arg;
    } else {
      throw backupsError('invalid_arguments', `只接受一个文件名前缀,多给了: ${arg}`);
    }
  }
  if (opts.diff && !opts.base) {
    throw backupsError('invalid_arguments', '--diff 必须指定要预览的备份:给出它的备份名,例如 mixctl backups --diff settings.json.bak-mixui-20260601-120000-000-abcd');
  }
  // --file 只在 --diff 下有意义:清点按目标表走,没有"指定现役文件"这回事。
  if (opts.file !== null && !opts.diff) {
    throw backupsError('invalid_arguments', '--file 只在 --diff 下有意义');
  }
  return opts;
}

async function backupsCmd(args) {
  const opts = parseBackupsArgs(args);
  if (opts.help) return console.log(BACKUPS_USAGE);
  // --diff 走另一条路:它要的是**一份指定的备份**,不是"某个前缀下的所有备份池"。
  if (opts.diff) return diffCmd(opts);
  const locations = backupLocations().filter(loc => backupView.matchesBase(loc, opts.base));
  if (!locations.length) throw backupsError('invalid_arguments', `没有配置匹配前缀 ${JSON.stringify(opts.base)} 的备份池(可用:${backupLocations().map(l => path.basename(l.file)).join(' / ')})`);
  const scanned = locations.map(loc => backupView.scanLocation(loc, BACKUPS_KEEP));
  return { ok: true, keep: BACKUPS_KEEP, dirs: scanned, diff: null };
}

// ---- --diff:预览**一份指定备份**与它现役文件的差异
// 现役文件是**推**出来的:用户给的是一个备份名,而 compareWithLive 要两个路径。推导过程逐条:
//   1. 备份名 -> base,用 naming.js 的 baseFromBackupName(推不出返回 null)。推不出就报错,
//      **不许猜一个来比** —— 猜错的那个文件与备份毫无关系,而预览会照常给出一份"差异报告",
//      看着专业、结论是错的(这条与 compare.js 内部 mismatched-base 那条 note 同一精神)。
//   2. base -> 受管目标(目标表里 basename 等于 base 的那一条)。命中 0 条或 >1 条都报错:
//      0 条说明这个备份不属于任何受管文件;>1 条说明 base 有歧义,拿哪条都不确定。
//   3. 现役文件 = 该目标的 file。**它是推出来的,结果里带 fileInferred:true**,不静静替用户猜。
//      要覆盖就显式给 --file <现役路径>,此时 fileInferred 为 false。
// 备份路径:参数带路径分隔符就当路径用(备份可能不在原位);只给基名就按"与现役文件同目录"
// 去拼 —— 那是 backupFile 唯一会写备份的地方。
//
// 关于 secrets(已知值层):这条命令**不读 providers.json、也不经 _state.store**,所以手上没有
// 渠道密钥清单,脱敏只有 compare.js 的**形状层**在起作用。这一点写进结果里(redaction.secrets),
// 不当作"已经完整脱敏"报出去 —— 自定义格式的密钥形状判据认不出来,那正是已知值层要补的洞。
// 为了补这个洞去读 providers.json(混着明文 api_key)等于把明文密钥穿过一个面向控制台的命令,
// 不做。
function diffCmd(opts) {
  const arg = opts.base;
  const givenPath = typeof arg === 'string' && arg.includes(path.sep);
  const backupPath = givenPath ? path.resolve(arg) : null;
  const backupName = path.basename(arg);
  const base = baseFromBackupName(backupName);
  if (!base) {
    throw backupsError('undecidable_base', `从 ${JSON.stringify(backupName)} 推不出它备份的是哪个文件(名字里没有 ${'.bak-mixui-'} 段);--diff 不接受猜一个来比。请给出完整的备份名,或先用 mixctl backups 看清单`);
  }
  const live = opts.file ? path.resolve(opts.file) : null;
  const inferred = !live;
  // 按 base 找出这条备份属于哪个受管文件。**无论现役文件是不是显式给的都要做这一步** ——
  // 只给基名(不带路径)的备份要有个目录去拼路径,而那个目录就是受管文件的目录。
  const hits = backupLocations().filter(loc => path.basename(loc.file) === base);
  let target = hits.length === 1 ? hits[0] : null;
  let file = live;
  if (file === null) {
    if (!target) {
      throw backupsError('undecidable_target', hits.length
        ? `备份名推出的 ${base} 同时对应多个受管文件(${hits.map(h => h.file).join(' / ')}),拿哪条都不确定;用 --file <现役路径> 指明`
        : `备份名推出的 ${base} 不是任何受管配置(受管的是 ${backupLocations().map(l => path.basename(l.file)).join(' / ')});用 --file <现役路径> 指明`);
    }
    file = target.file;
  }
  // 备份路径:带路径就当路径用(备份可能不在原位);只给基名就得有个目录来拼。
  // 目录优先取受管的那个;base 不在受管表里时(用户配了 --file 指一个自定义文件),
  // 退到现役文件的目录 —— backupFile 只会把备份写在活文件同目录,这是它唯一的行为。
  let resolvedBackup = backupPath;
  if (!resolvedBackup) {
    const dir = target ? target.dir : path.dirname(file);
    resolvedBackup = path.join(dir, backupName);
  }
  let result;
  try {
    result = compareWithLive({ file, backupPath: resolvedBackup, maxBytes: BACKUPS_MAX_BYTES });
  } catch (e) {
    throw backupsError(e.code || 'compare_failed', e.message);
  }
  return {
    ok: true, keep: BACKUPS_KEEP, dirs: [],
    diff: {
      backup: backupName, backupPath: resolvedBackup,
      file, fileInferred: inferred,
      // 推出来的现役文件必须自报来源,别让调用方以为它是显式给的。
      fileSource: inferred ? `由备份名推出(base=${base}),未经用户确认` : '用户以 --file 显式指定',
      targetId: target ? target.id : null,
      // 已知值层缺席这件事要在结果里说清楚(见 diffCmd 文件头),不假装已完整脱敏。
      redaction: { ...result.redaction, secrets: 'unavailable', note: '本次未提供已知密钥清单,仅形状层生效;自定义格式的密钥可能不被盖住' },
      result,
    },
  };
}

async function runBackupsCmd(args) {
  const json = args.includes('--json');
  try {
    const result = await backupsCmd(args);
    if (result === undefined) return;             // --help 已经自己打印过用法
    if (json) console.log(JSON.stringify(result, null, 2)); else backupView.printBackups(result);
  } catch (e) {
    if (json) console.log(JSON.stringify({ ok: false, error: { code: e.code || 'backups_failed', message: e.message } }, null, 2));
    else { console.log(`清点失败 [${e.code || 'backups_failed'}]: ${e.message}`); console.log(BACKUPS_USAGE); }
    process.exitCode = 1;
  }
}

// 运行期日志清理:清掉超过 N 天的 responses 归档目录与 launchd.log。
// 与服务内定时器共用 lib/log-retention.js 的同一份逻辑,靠 .retention.lock 串行 ——
// 服务在跑时执行本命令也安全(并发只会让其中一方本轮跳过)。
// 默认只报数(--dry-run 是默认行为),加 --apply 才真删;天数为位置参数,默认走 MIXR_LOG_RETAIN_DAYS 或 2。
// requests.jsonl 不归这里(它由 request-log 那套按天轮转管理),所以本命令不需要 --archives-only。
function gc(args = []) {
  const apply = args.includes('--apply');
  const archiveOnly = args.includes('--archives-only');
  const daysArg = args.find(a => /^[0-9]+$/.test(a));
  const { sweepLogs, DEFAULT_RETAIN_DAYS } = require('./lib/log-retention');
  const envDays = Number(process.env.MIXR_LOG_RETAIN_DAYS);
  const retainDays = daysArg !== undefined ? Number(daysArg)
    : (Number.isSafeInteger(envDays) && envDays >= 0 ? envDays : DEFAULT_RETAIN_DAYS);
  // CLI 是一次性任务,不限单轮删除数(服务内定时器才需要把单次卡顿压到 1s 级)。
  // 清理目录从 paths 取,与上面 REQ_LOG 同一份计算;这里原先又自己拼了一遍
  // `MIXR_DATA_DIR || ROOT` —— 第三次拼同一个语义,正是本模块要收掉的重复。
  const r = sweepLogs({ directory: paths.logDir(process.env, ROOT), retainDays, dryRun: !apply, maxRemovalsPerSweep: 0, archiveOnly });
  if (r.skipped === 'disabled') return console.log(`日志保留已关闭(retainDays=${retainDays});不改动任何文件`);
  if (r.skipped === 'no_dir') return console.log('logs/ 目录不存在,无需清理');
  if (r.skipped === 'locked') return console.log('另一处清理正在进行(锁被占用),本轮跳过');
  const mb = n => (Number(n || 0) / 1048576).toFixed(1) + 'MB';
  console.log(`${apply ? '已清理' : '将清理(预览,--apply 才实删)'} 保留 ${retainDays} 天(截止 ${r.cutoff})${archiveOnly ? '[仅 responses 归档]' : ''}:`);
  // requests.jsonl / .old 归 request-log 的按天轮转管,这里只在模块确实报了这两项时才打印 ——
  // 写死输出会在保留清理不碰它们时给出"删了 0 行"的假象。
  if (r.requests) console.log(`  requests.jsonl     删 ${r.requests.dropped} 行,留 ${r.requests.kept} 行`);
  if (r.rotation) console.log(`  requests.jsonl.old ${r.rotation.deleted ? '整份删除' : `删 ${r.rotation.dropped || 0} 行`}`);
  if (r.launchd) console.log(`  launchd.log        删 ${r.launchd.dropped || 0} 行,留 ${r.launchd.kept || 0} 行`);
  if (r.responses) console.log(`  responses 归档     删 ${r.responses.removed} 个目录(约 ${mb(r.responses.bytes)}),跳过无关项 ${r.responses.skipped || 0} 个`);
  for (const e of r.errors) console.log(`  ⚠ 失败项 ${e}`);
}

// logs 的两条通路,按**控制台是否可达**选,不靠参数猜:
//   · 控制台在跑 —— 走 /api/logs,历史、游标、时间窗、各维筛选都在那边。
//   · 连不上   —— 退回本机 requests.jsonl 的只读尾读(有界反读,坏行跳过)。
// 退回是为了"服务没起来时还能看上一轮的日志",不是替代 API:把"控制台没跑"报成
// "没有日志",会把一次停机的排查引向错的方向。退回只认位置式条数 —— 带选项的查询
// (历史/游标/筛选)没有文件版对应物,如实说明,不假装支持。
// 只有**连不上**才退回;真的 API 报错(游标过期、选项写错)原样报到 stderr 并以非 0 退出,
// 不能借退回把服务端的错误吞掉 —— 那正是最需要看到的一类错误。
// 离线退回用的文件尾读:位置式条数 → 本机 requests.jsonl 的有界反读(log-tail,坏行跳过)。
// 与 /api/logs 的区别不是"新旧",而是数据源:这里读的是**本进程看得见的那个文件**。
function logs(arg) {
  let result;
  try { result = selectLogs(REQ_LOG, resolveCount(arg)); }
  catch { return console.log('暂无请求日志'); }
  if (result.incomplete) console.error('日志尾读达到上限或文件在读取期间被截短,以下仅为已读到的完整记录。');
  if (!result.entries.length) {
    if (!result.incomplete) console.log('暂无请求日志');
    return;
  }
  for (const e of result.entries) console.log(formatLogLine(e));
}

const OFFLINE_RE = /ECONNREFUSED|ECONNRESET|EHOSTUNREACH|ENOTFOUND|ECONNABORTED|ETIMEDOUT|socket hang up/i;
async function logsCmd(args) {
  let errText = '';
  const code = await runLogs(args, { request: api, stderr: { write: text => { errText += text; } } });
  if (code === 0) { process.exitCode = 0; return; }
  if (!OFFLINE_RE.test(errText)) { process.stderr.write(errText); process.exitCode = code; return; }
  if (args.some(a => a.startsWith('-'))) {
    process.stderr.write('logs: 控制台不可达,离线只支持 `mixctl logs [条数]`;带选项的查询需要控制台在运行。\n');
    process.exitCode = 1;
    return;
  }
  const positional = args.filter(a => !a.startsWith('-'));
  logs(positional[positional.length - 1]);
}

// ---------------------------------------------------------------- probe
// 对**一个渠道登记过的每个模型**各探一次活。真正的测活跃服务端(lib/model-probe.js 与
// POST /api/providers/:id/models/test):本文件只负责解析参数、把渠道名解析成 id、把结果
// 摊成一张能进日志的纯文本表。
//
// 与渠道测试(lib/provider-test.js)的分工:那个回答"渠道通不通",一个坏模型会让整张卡片变红;
// probe 逐模型给结论,坏的是哪一个一眼能看见。代价是**每个模型都真的向上游发一次生成请求**,
// 会消耗额度 —— 这也是这里不做任何自动重试或换渠道的原因:一次调用几次请求要对得上。
const PROBE_WIRES = ['anthropic', 'responses', 'chat'];
const PROBE_REASON_MAX = 60;
const probeError = (code, message) => Object.assign(new Error(message), { code });

function parseProbeArgs(args) {
  const opts = { json: false, help: false, channel: undefined, models: [], keyId: undefined, wire: undefined };
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === '--json') {
      if (opts.json) throw probeError('invalid_arguments', '--json 不能重复');
      opts.json = true;
    } else if (arg === '--key-id' || arg === '--wire') {
      const key = arg === '--key-id' ? 'keyId' : 'wire';
      if (opts[key] !== undefined) throw probeError('invalid_arguments', `${arg} 不能重复`);
      const value = args[++i];
      if (!value || value.startsWith('--')) throw probeError('invalid_arguments', `${arg} 缺少值`);
      opts[key] = value;
    } else if (arg === '--help' || arg === '-h') {
      opts.help = true;
    } else if (arg.startsWith('-')) {
      throw probeError('invalid_arguments', `无法识别的 probe 选项: ${arg};仅支持 --key-id / --wire / --json / --help`);
    } else if (opts.channel === undefined) {
      opts.channel = arg;
    } else {
      opts.models.push(arg);
    }
  }
  if (opts.help) return opts;
  if (!opts.channel) throw probeError('invalid_arguments', 'probe 需要指定渠道(渠道ID或渠道名)');
  // 非法 wire 在**本地**就拒掉:发出去才发现写错,服务器只能回一句 400,还白等一轮。
  if (opts.wire !== undefined && !PROBE_WIRES.includes(opts.wire))
    throw probeError('invalid_arguments', `--wire 必须是 ${PROBE_WIRES.join(' / ')} 之一`);
  return opts;
}

// 渠道查找:**先 id 后 name**,两组都按 claude → codex 的顺序。
//   · id 是机器标识,全库唯一;能按 id 命中时不必看名字。
//   · name 是人写的标签,不保证唯一,两个组各有一个同名渠道完全合法。此时必须给一个
//     确定的答案,不能"按数组顺序碰运气" —— 组顺序就是控制台的默认视图顺序(Claude 在前),
//     同名时取 Claude 组与用户在主标签页看到的那条一致。
// 取不到就报错并列出可用渠道,**不猜**一个最像的:猜错等于把真实请求发给另一个渠道。
function findProbeChannel(state, want) {
  const groups = ['claude', 'codex'].map(app => ({ app, list: (state.providers && state.providers[app]) || [] }));
  for (const g of groups) {
    const hit = g.list.find(p => p.id === want);
    if (hit) return { app: g.app, provider: hit };
  }
  for (const g of groups) {
    const hit = g.list.find(p => p.name === want);
    if (hit) return { app: g.app, provider: hit };
  }
  const available = groups.flatMap(g => g.list.map(p => `${p.id}(${p.name})`)).slice(0, 20);
  throw probeError('unknown_channel',
    `没有匹配的渠道 ${JSON.stringify(want)};可用渠道(id(名称),最多列 20 个):${available.join(' / ') || '(无)'}`);
}

const probeReason = text => {
  const s = String(text == null ? '' : text);
  return s.length > PROBE_REASON_MAX ? s.slice(0, PROBE_REASON_MAX) + '…' : s;
};

function printProbe(result, provider) {
  const results = Array.isArray(result.results) ? result.results : [];
  console.log(`渠道 ${provider.name} (${provider.id}) · 协议 ${result.wire} · ${results.length} 个模型 · ${result.total_ms}ms`);
  // 纯文本、无颜色:这份输出要能原样进日志或被 diff,ANSI 只会变成乱码。
  // 中文按 padEnd 的字符数对齐,视觉宽度不完美,但同一张表里每一行的列位置一致。
  console.log(`${'模型'.padEnd(22)}${'结论'.padEnd(7)}${'状态'.padEnd(7)}耗时`);
  for (const r of results) {
    const verdict = r.ok ? '通过' : '失败';
    const status = r.status === null || r.status === undefined ? '-' : String(r.status);
    const reason = !r.ok && r.error ? `   ${probeReason(r.error)}` : '';
    console.log(`${String(r.model || '').padEnd(22)}${verdict.padEnd(7)}${status.padEnd(7)}${r.ms}ms${reason}`);
  }
}

async function probeCmd(args) {
  const json = args.includes('--json');
  try {
    const opts = parseProbeArgs(args);
    if (opts.help) return console.log(PROBE_USAGE);
    let state;
    try { state = await api('/api/state'); }
    catch (e) {
      // 与 logsCmd 同一判据:连不上是"服务没在跑",不是渠道坏了。把这句原样抛出去
      // 会让人以为上游或渠道出了故障(OFFLINE_RE 的用意),所以先翻译成人话。
      if (OFFLINE_RE.test(e.message || e.code || ''))
        throw probeError('console_unreachable', '控制台不可达,probe 需要服务在运行;先执行 mixctl start(或查看 mixctl logs)');
      throw probeError('state_failed', `读取渠道清单失败:${e.message}`);
    }
    const { provider } = findProbeChannel(state, opts.channel);
    const body = {};
    if (opts.models.length) body.models = opts.models;
    if (opts.keyId !== undefined) body.key_id = opts.keyId;
    if (opts.wire !== undefined) body.wire = opts.wire;
    const result = await apiPost(`/api/providers/${encodeURIComponent(provider.id)}/models/test`, body);
    if (!result || !Array.isArray(result.results))
      throw probeError('invalid_response', '测活接口返回的结果缺少 results');
    if (json) console.log(JSON.stringify(result, null, 2)); else printProbe(result, provider);
    // 退出码要能把"有模型失败"传给脚本:文本表是给人看的,而脚本(以及 CI)只看 exit code。
    // 失败用 1,与 explain/backups 的"有失败"同档;0 表示这次探到的模型全部通过。
    const failed = typeof result.failed === 'number' ? result.failed : result.results.filter(r => !r.ok).length;
    process.exitCode = failed > 0 ? 1 : 0;
  } catch (e) {
    const error = { code: e.code || 'probe_failed', message: e.message };
    if (json) console.log(JSON.stringify({ ok: false, error }, null, 2));
    else {
      console.log(`探活失败 [${error.code}]: ${error.message}`);
      if (error.code === 'invalid_arguments') console.log(PROBE_USAGE);
    }
    process.exitCode = 1;
  }
}

const cmd = process.argv[2] || 'status';
if (cmd === 'start') start();
else if (cmd === 'stop') stop();
else if (cmd === 'restart') { const pid = getPid(); if (pid && alive(pid)) stop(); setTimeout(start, 600); }
else if (cmd === 'status') status();
else if (cmd === 'ls') ls();
// sessions 无参数时仍是原来的活跃对话列表(api 走 /api/state);带了子命令才转给会话覆盖那套读写。
else if (cmd === 'sessions' || cmd === 'sess') {
  const rest = process.argv.slice(3);
  if (!rest.length) sessions();
  else runSessions(rest, {
    // 会话覆盖要读 404/409/400 的错误体来分型,apiPost 会把它们压成一句 Error.message,
    // 所以这里给它一个带回状态码与原始体的通道;路径与超时由调用方给,本函数只负责发。
    //
    // 三条收尾都必须做,少一条就会挂住或报错报错原因:
    //   · 响应体只在**收完整**时才解析 — 半截 JSON 解出来的是 {} 而不是"没收到",
    //     会把一次中断报成"字段不完整",把人引去做错的排查。
    //   · res 的 error/aborted(服务端中途断流)以前没人接:Promise 永远不落,命令就那么挂着。
    //   · 超时由调用方传(sessions.js 的 REQUEST_TIMEOUT_MS),这里只负责在到点时放弃并销毁请求。
    request: (method, p, body, timeoutMs) => new Promise((ok, bad) => {
      const data = body === undefined ? '' : JSON.stringify(body);
      let settled = false;
      let timer = null;
      const done = (error, value) => {
        if (settled) return;
        settled = true;
        if (timer) clearTimeout(timer);
        if (error) bad(error); else ok(value);
      };
      const req = http.request({ hostname: '127.0.0.1', port: Number(UI_PORT), path: p, method,
        headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } }, r => {
        let s = '';
        r.on('data', c => s += c);
        r.on('aborted', () => done(new Error('控制台在收完响应前中断了连接')));
        r.on('error', e => done(new Error(`读取控制台响应失败:${(e && e.message) || e}`)));
        r.on('end', () => {
          if (!r.complete) return done(new Error('控制台响应被截断'));
          let parsed = {};
          try { parsed = JSON.parse(s); } catch {}   // 非 JSON 体按空对象走,由状态码分型
          done(null, { status: r.statusCode, data: parsed });
        });
      });
      req.on('error', e => done(e));
      req.end(data);
      if (Number.isFinite(timeoutMs) && timeoutMs > 0)
        timer = setTimeout(() => { req.destroy(); done(new Error(`等待控制台响应超过 ${timeoutMs}ms`)); }, timeoutMs);
    }),
  }).then(code => { process.exitCode = code; });
}
else if (cmd === 'slots') slotsCmd();
else if (cmd === 'explain') explainCmd(process.argv.slice(3));
else if (cmd === 'probe') probeCmd(process.argv.slice(3));
else if (cmd === 'backups') runBackupsCmd(process.argv.slice(3));
else if (cmd === 'restore') runRestoreCmd(process.argv.slice(3), { root: ROOT, home: os.homedir(), env: process.env });
else if (cmd === 'split') splitCmd(process.argv.slice(3));
else if (cmd === 'logs') logsCmd(process.argv.slice(3));
else if (cmd === 'gc') gc(process.argv.slice(3));
else if (cmd === 'route') route(process.argv[3], process.argv[4] && !process.argv[4].startsWith('--') ? process.argv[4] : 'anthropic', process.argv.includes('--slots'));
else if (cmd === 'open') execSync(`open http://127.0.0.1:${UI_PORT}`);
else console.log(MAIN_USAGE);
