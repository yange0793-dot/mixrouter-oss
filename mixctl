#!/usr/bin/env node
// mixctl — mixrouter 管理命令
//   start | stop | restart | status | ls | sessions | slots | explain | backups | restore | probe | logs [n] | gc [天] [--apply] [--archives-only] | route [claude|codex|zcode] [--slots] | open | help
'use strict';
const { spawn, execSync } = require('child_process');
const http = require('http');
const fs = require('fs');
const path = require('path');
const os = require('os');
const { codeRevision } = require('./lib/runtime-code');
const { selectLogs, resolveCount, formatLogLine } = require('./lib/observability/log-tail');
const { compareWithLive } = require('./lib/backup/compare');
const { backupTargets } = require('./lib/backup/targets');
const { baseFromBackupName } = require('./lib/backup/naming');
// CLI 呈现层:备份清点的摊平/打印,与用法串。两者原先都长在本文件里,
// 与 lib/backup/* 的职责混在一起;搬出去之后本文件只剩"取数 + 拼参数 + 分发"。
const backupView = require('./lib/cli/backup-view');
const { runRestoreCmd } = require('./lib/cli/restore');
const { runLogs } = require('./lib/cli/logs');
const { runSessions } = require('./lib/cli/sessions');
const { EXPLAIN_USAGE, BACKUPS_USAGE, PROBE_USAGE, SPLIT_USAGE, ROUTE_USAGE, MAIN_USAGE } = require('./lib/cli/usage');
// 三类路径(开发副本 / 发布目录 / 数据目录)的唯一来源。本文件原先自己拼了四遍
// (ROOT / RUN_DIR / PID_FILE / REQ_LOG),那四行与 mixrouter.js 的同名常量、以及
// scripts/launchd-run.sh 里的 `$DIR/.run`,靠"都在仓库根"这一条巧合对齐。
const paths = require('./lib/paths');

const ROOT = __dirname;
const RUN_DIR = paths.runDir(ROOT);
const PID_FILE = paths.pidFile(ROOT);
const SERVER_LOG = paths.serverLog(ROOT);
// 数据目录的真值与 mixrouter.js 的 DATA_DIR 是同一份计算(都经 LIVE_FILES.dataDir),
// 不再各写一遍 `process.env.MIXR_DATA_DIR || ROOT`。
const REQ_LOG = paths.requestsLog(process.env, ROOT);
const UI_PORT = process.env.MIXUI_PORT || 8788;
// 常驻由 LaunchAgent 兜:装了它,start 就走 launchd,不另起一个不受监管的野进程。
// label 按本机实际装的 plist 找(名字形如 *.mixrouter.plist),源码里不写死用户名。
const LAUNCHD_DIR = paths.launchAgentDir(os.homedir());
function launchdJob() {
  try {
    const f = fs.readdirSync(LAUNCHD_DIR).find(n => n.endsWith('.mixrouter.plist'));
    return f ? { label: path.basename(f, '.plist'), plist: path.join(LAUNCHD_DIR, f) } : null;
  } catch { return null; }
}

const alive = pid => { try { process.kill(pid, 0); return true; } catch { return false; } };
const getPid = () => { try { return Number(fs.readFileSync(PID_FILE, 'utf8').trim()); } catch { return 0; } };
const api = p => new Promise((ok, bad) => {
  http.get(`http://127.0.0.1:${UI_PORT}${p}`, r => {
    let s = ''; r.on('data', c => s += c); r.on('end', () => { try { ok(JSON.parse(s)); } catch (e) { bad(e); } });
  }).on('error', bad);
});
const apiPost = (p, body = {}) => new Promise((ok, bad) => {
  const data = JSON.stringify(body);
  const req = http.request({ hostname: '127.0.0.1', port: UI_PORT, path: p, method: 'POST', headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } }, r => {
    let s = ''; r.on('data', c => s += c);
    r.on('end', () => { let j = {}; try { j = JSON.parse(s); } catch {} if (r.statusCode >= 400) bad(new Error(j.error || ('HTTP ' + r.statusCode))); else ok(j); });
  });
  req.on('error', bad); req.end(data);
});

// explain 单独走结构化协议,不复用会把 error 对象变成 [object Object] 的 apiPost。
// (EXPLAIN_USAGE 等用法串在 lib/cli/usage.js,与顶层总览同处维护)
const EXPLAIN_INPUT_LIMIT = 1024 * 1024;
const EXPLAIN_RESPONSE_LIMIT = 2 * 1024 * 1024;
const EXPLAIN_TIMEOUT_MS = 5000;
const explainError = (code, message) => Object.assign(new Error(message), { code });

function explainArgs(args) {
  const opts = {}, positional = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === '--json') {
      if (opts.json) throw explainError('invalid_arguments', '--json 不能重复');
      opts.json = true;
    } else if (['--kind', '--session', '--input', '--ua', '--body'].includes(arg)) {
      const key = arg.slice(2);
      if (opts[key] !== undefined) throw explainError('invalid_arguments', `${arg} 不能重复`);
      const value = args[++i];
      if (!value || value.startsWith('--')) throw explainError('invalid_arguments', `${arg} 缺少值`);
      opts[key] = value;
    } else if (arg.startsWith('-')) {
      throw explainError('invalid_arguments', '无法识别的 explain 选项;仅支持 --kind / --session / --input / --ua / --body / --json');
    } else positional.push(arg);
  }
  if (opts.input !== undefined) {
    if (positional.length || opts.kind !== undefined || opts.session !== undefined
        || opts.ua !== undefined || opts.body !== undefined)
      throw explainError('invalid_arguments', '--input 与位置参数、--kind、--session、--ua、--body 互斥');
  } else {
    // 两种位置式写法都认:
    //   · `explain <app> <model>`(app 显式给)—— 校验 app 取值;
    //   · `explain <model> [codex]`(本地旧写法,app 缺省 claude)—— 'codex' 只作为组选择器,
    //     且只认最后一个位置参数,免得把恰好叫 codex 的模型名吃掉。
    let app = 'claude', model;
    if (positional.length === 2) {
      // app 取值不在这里判:交给 validateExplainInput,好让"app 非法"与 kind/context 的
      // 非法一样落在 invalid_input 这一档(错误码是接口契约,同一个错因不能有两个码)。
      [app, model] = positional;
    } else if (positional.length === 1 && !['claude', 'codex'].includes(positional[0])) {
      // 单个位置参数:本地写法里的裸模型名(app 缺省 claude)。
      // 'claude'/'codex' 除外 —— 它们是组名,单独出现只可能是 main 那条写法漏了 model,
      // 当成模型名会让 `explain claude` 静默变成一次成功的预览,与"缺 model 要报错"相反。
      model = positional[0];
    } else {
      throw explainError('invalid_arguments', '必须提供 app 和 model 两个位置参数,或只给模型名');
    }
    if (typeof model !== 'string' || !model) throw explainError('invalid_arguments', '必须提供模型名');
    // context 只在真有内容时才出现:空对象不是"没给上下文"的对等物,预览接口对
    // "字段在不在"敏感(缺省走新会话预览,给空对象等于声称给了一份上下文)。
    const context = {};
    if (opts.session !== undefined) context.session = opts.session;
    if (opts.ua !== undefined) context.ua = opts.ua;
    if (opts.body !== undefined) context.bodyText = opts.body;
    opts.body = { app, model,
      ...(opts.kind !== undefined ? { kind: opts.kind } : {}),
      ...(Object.keys(context).length ? { context } : {}) };
  }
  return opts;
}

function validateExplainInput(body) {
  const object = v => !!v && typeof v === 'object' && !Array.isArray(v);
  const invalid = message => { throw explainError('invalid_input', message); };
  if (!object(body)) invalid('预览输入必须是 JSON 对象');
  if (Object.keys(body).some(k => !['app', 'model', 'kind', 'context'].includes(k))) invalid('预览输入含未知字段');
  if (!['claude', 'codex'].includes(body.app)) invalid('app 必须是 claude 或 codex');
  if (body.model !== undefined && typeof body.model !== 'string') invalid('model 必须是字符串');
  const kinds = body.app === 'claude' ? ['messages', 'count_tokens'] : ['responses', 'chat/completions'];
  if (body.kind !== undefined && !kinds.includes(body.kind)) invalid(`kind 必须是 ${kinds.join(' / ')}`);
  if (body.context !== undefined) {
    if (!object(body.context)) invalid('context 必须是对象');
    for (const [key, value] of Object.entries(body.context)) {
      if (key === 'compactTexts') {
        if (!Array.isArray(value) || value.some(t => typeof t !== 'string')) invalid('context.compactTexts 必须是字符串数组');
        continue;
      }
      if (!['session', 'ua', 'token', 'bodyText'].includes(key)) invalid('context 含未知字段');
      if (typeof value !== 'string') invalid(`context.${key} 必须是字符串`);
    }
    if (body.context.session !== undefined && !/^(?:cc|cx|fp|cxf):\S+$/.test(body.context.session))
      invalid('session 必须是带 cc:/cx:/fp:/cxf: 前缀的完整会话键,不能用短 id');
  }
  return body;
}

function readExplainInput(file) {
  if (file !== '-') {
    let stat;
    try { stat = fs.statSync(file); }
    catch { throw explainError('input_read_error', '无法读取预览输入文件'); }
    if (!stat.isFile()) throw explainError('input_read_error', '--input 必须指向普通文件,或用 - 读取 stdin');
    if (stat.size > EXPLAIN_INPUT_LIMIT) throw explainError('input_too_large', '预览输入超过 1 MiB 上限');
  }
  return new Promise((resolve, reject) => {
    const stream = file === '-' ? process.stdin : fs.createReadStream(file);
    const chunks = [];
    let bytes = 0, settled = false;
    const finish = (error, text) => {
      if (settled) return;
      settled = true; clearTimeout(timer);
      if (error) { stream.destroy(); reject(error); } else resolve(text);
    };
    const timer = setTimeout(() => finish(explainError('input_timeout', '读取预览输入超过 5000ms')), EXPLAIN_TIMEOUT_MS);
    stream.on('data', chunk => {
      bytes += chunk.length;
      if (bytes > EXPLAIN_INPUT_LIMIT) return finish(explainError('input_too_large', '预览输入超过 1 MiB 上限'));
      chunks.push(chunk);
    });
    stream.on('end', () => finish(null, Buffer.concat(chunks).toString('utf8')));
    stream.on('error', () => finish(explainError('input_read_error', '读取预览输入失败')));
    stream.on('close', () => { if (!settled) finish(explainError('input_read_error', '预览输入在读完前关闭')); });
  });
}

function previewRequest(body) {
  return new Promise((resolve, reject) => {
    const port = Number(UI_PORT);
    if (!Number.isInteger(port) || port < 1 || port > 65535)
      return reject(explainError('invalid_port', 'MIXUI_PORT 必须是 1–65535 的端口号'));
    const data = JSON.stringify(body);
    if (Buffer.byteLength(data) > EXPLAIN_INPUT_LIMIT)
      return reject(explainError('input_too_large', '预览输入超过 1 MiB 上限'));
    let settled = false, responded = false;
    const finish = (error, value) => {
      if (settled) return;
      settled = true; clearTimeout(timer);
      if (error) reject(error); else resolve(value);
    };
    const req = http.request({ hostname: '127.0.0.1', port, path: '/api/routing/preview', method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } }, res => {
      responded = true;
      const chunks = [];
      let bytes = 0;
      res.on('data', chunk => {
        bytes += chunk.length;
        if (bytes > EXPLAIN_RESPONSE_LIMIT) {
          finish(explainError('response_too_large', '预览响应超过 2 MiB 上限'));
          res.destroy(); req.destroy(); return;
        }
        chunks.push(chunk);
      });
      res.on('aborted', () => finish(explainError('response_aborted', '预览响应在收完前被中断')));
      res.on('error', () => finish(explainError('response_error', '读取预览响应失败')));
      res.on('close', () => { if (!res.complete) finish(explainError('response_aborted', '预览响应在收完前关闭')); });
      res.on('end', () => {
        let result;
        try { result = JSON.parse(Buffer.concat(chunks).toString('utf8')); }
        catch { return finish(explainError('invalid_response_json', '预览接口返回的不是合法 JSON')); }
        if (!result || typeof result !== 'object' || Array.isArray(result))
          return finish(explainError('invalid_response', '预览接口返回的不是结果对象'));
        if (typeof result.ok !== 'boolean' || (!result.ok && (!result.error || typeof result.error.message !== 'string'))) {
          if (res.statusCode >= 400) return finish(null, { ok: false, error: { code: 'preview_http_error',
            httpStatus: res.statusCode, message: typeof result.error === 'string' ? result.error : `HTTP ${res.statusCode}` } });
          return finish(explainError('invalid_response', '预览接口响应缺少 ok/error 字段'));
        }
        if (res.statusCode >= 400 && result.ok)
          return finish(explainError('invalid_response', '预览接口 HTTP 状态与结果不一致'));
        finish(null, result);
      });
    });
    // 总时限不随零碎响应重置,避免一直滴数据把命令吊住;旧 api/apiPost 行为保持不动。
    const timer = setTimeout(() => {
      finish(explainError('request_timeout', '路由预览请求超过 5000ms')); req.destroy();
    }, EXPLAIN_TIMEOUT_MS);
    // 已经收到响应头之后再断流,是"响应被截断",不能说成连不上——服务器中途 reset 时
    // req 的 error 常常先于 res 的 close 到达,只看 req.error 会把真实原因盖掉。
    // 一个字节响应头都没收到时也分两种:连不上(拒绝/找不到)与连上了但被对端 reset,
    // 前者该去查服务在不在跑,后者该去查它是不是刚重启,处理方法不同。
    req.on('error', err => {
      if (responded) return finish(explainError('response_aborted', '预览响应在收完前被中断'));
      const reset = ['ECONNRESET', 'EPIPE', 'ERR_STREAM_PREMATURE_CLOSE'].includes(err && err.code);
      finish(reset
        ? explainError('connection_reset', '与本机路由预览接口的连接在读到头之前被中断(服务可能在处理中重启)')
        : explainError('request_failed', '无法连接本机路由预览接口'));
    });
    req.end(data);
  });
}

function printPreview(result) {
  if (!result.ok) console.log(`预览失败 [${result.error.code}]: ${result.error.message}`);
  if (result.matched) console.log(`命中: ${result.matched.via} ${result.matched.ruleId || '(兜底)'}${result.matched.slot ? '  槽位 ' + result.matched.slot : ''}`);
  if (result.selection) {
    const s = result.selection, p = s.predicted;
    console.log(`首选来源: ${s.source}  策略: ${s.strategy}  ${s.deterministic ? '当前快照可确定' : '不确定'}`);
    console.log(p ? `首选: ${p.providerName || p.providerId} (${p.providerId}) @ ${p.model || '(透传请求模型)'}`
      : `可选渠道: ${(s.candidates || []).join(' / ') || '(无)'}`);
    console.log(s.note);
  }
  for (const w of result.warnings || []) console.log(`提醒 [${w.code}]: ${w.message}`);
}

async function explainCmd(args) {
  const json = args.includes('--json');
  if (args.length === 1 && args[0] === '--help') return console.log(EXPLAIN_USAGE);
  try {
    const opts = explainArgs(args);
    let body = opts.body;
    if (opts.input !== undefined) {
      const text = await readExplainInput(opts.input);
      try { body = JSON.parse(text); }
      catch { throw explainError('invalid_input_json', '预览输入不是合法 JSON'); }
    }
    const result = await previewRequest(validateExplainInput(body));
    if (json) console.log(JSON.stringify(result, null, 2)); else printPreview(result);
    if (!result.ok) process.exitCode = 1;
  } catch (e) {
    const result = { ok: false, error: { code: e.code || 'preview_failed', message: e.message } };
    if (json) console.log(JSON.stringify(result, null, 2));
    else { printPreview(result); if (e.code === 'invalid_arguments') console.log(EXPLAIN_USAGE); }
    process.exitCode = 1;
  }
}

function start() {
  const pid = getPid();
  if (pid && alive(pid)) return console.log(`mixrouter 已在运行 (pid ${pid}),控制台 http://127.0.0.1:${UI_PORT}`);
  fs.mkdirSync(RUN_DIR, { recursive: true });
  fs.mkdirSync(path.dirname(SERVER_LOG), { recursive: true });
  // 装了 LaunchAgent 就交给 launchd 拉:崩溃自愈、常驻由它兜,别在外面另起一个不受管的进程
  const job = launchdJob();
  if (job) {
    try {
      execSync(`launchctl kickstart -k gui/${process.getuid()}/${job.label}`, { stdio: ['ignore', 'ignore', 'pipe'] });
      const t0 = Date.now();
      const poll = () => api('/healthz')
        .then(() => console.log(`mixrouter 已由 launchd 拉起 (${job.label})\n  Claude 代理 http://127.0.0.1:8787/v1/messages\n  Codex  代理 http://127.0.0.1:8787/v1/responses\n  控制台      http://127.0.0.1:${UI_PORT}`))
        .catch(() => Date.now() - t0 > 6000
          ? console.log(`已 kickstart ${job.label},但端口未就绪,查看日志: mixctl logs`)
          : new Promise(r => setTimeout(r, 300)).then(poll));
      return poll();
    } catch (e) {
      console.log(`launchd 拉起失败(${String((e.stderr || e.message || '')).trim().slice(0, 120)}),改为直接派生`);
    }
  }
  const out = fs.openSync(SERVER_LOG, 'a');
  const child = spawn(process.execPath, [path.join(ROOT, 'mixrouter.js')], { detached: true, stdio: ['ignore', out, out], env: process.env });
  child.unref();
  fs.writeFileSync(PID_FILE, String(child.pid));
  // 等控制台端口就绪(最多 5s)
  const t0 = Date.now();
  const poll = () => api('/healthz').then(() => console.log(`mixrouter 已启动 (pid ${child.pid})\n  Claude 代理 http://127.0.0.1:8787/v1/messages\n  Codex  代理 http://127.0.0.1:8787/v1/responses\n  控制台      http://127.0.0.1:${UI_PORT}`))
    .catch(() => Date.now() - t0 > 5000 ? console.log(`已派生 pid ${child.pid},但端口未就绪,查看日志: mixctl logs`) : setTimeout(poll, 300));
  poll();
}
function stop() {
  const pid = getPid();
  if (!pid || !alive(pid)) { try { fs.unlinkSync(PID_FILE); } catch {} return console.log('mixrouter 未在运行'); }
  process.kill(pid, 'SIGTERM');
  const t0 = Date.now();
  const wait = () => alive(pid) ? (Date.now() - t0 > 4000 ? (process.kill(pid, 'SIGKILL'), console.log(`已强杀 pid ${pid}`))
    : setTimeout(wait, 200)) : (fs.unlinkSync(PID_FILE), console.log(`已停止 (pid ${pid})`));
  wait();
}
async function status() {
  const pid = getPid();
  const running = pid && alive(pid);
  console.log(`进程:   ${running ? `运行中 (pid ${pid})` : '未运行'}`);
  try {
    const s = await api('/api/state');
    console.log(`版本:   v${s.version}   运行时长 ${Math.floor(s.uptime_s / 60)} 分 ${s.uptime_s % 60} 秒`);
    const diskRevision = codeRevision(ROOT);
    if (!s.code_revision || !diskRevision) {
      console.log('代码:   ⚠ 无法核对已加载版本(旧服务或源码不可读);勿将健康检查当作补丁已生效');
      process.exitCode = 1;
    } else if (s.code_revision !== diskRevision) {
      console.log('代码:   ⚠ 源码已更新,运行进程仍是旧版;空闲时执行 mixctl restart 后再查 status');
      process.exitCode = 1;
    } else console.log(`代码:   已加载当前源码 ${diskRevision.slice(0, 12)}`);
    console.log(`端口:   代理 :${s.proxy_port}  控制台 :${s.ui_port}`);
    console.log(`今日:   ${s.stats.reqs} 次请求,入 ${s.stats.inTok} / 出 ${s.stats.outTok} tokens`);
  } catch { console.log('控制台不可达'); process.exitCode = 1; }
}
async function ls() {
  let s;
  try { s = await api('/api/state'); } catch { return console.log('mixrouter 未运行或控制台不可达'); }
  const nameOf = id => { for (const g of ['claude', 'codex']) { const p = s.providers[g].find(x => x.id === id); if (p) return p.name + (p.enabled ? '' : '(停用)'); } return '(未绑定)'; };
  // 目标既可能是单一渠道,也可能是渠道池(会话粘性分发),分开显示;规则可只对某一组生效
  const targetOf = r => {
    const pool = (r.pool || []).map(m => typeof m === 'string' ? m : m.provider);
    const appTag = r.app === 'codex' ? '[Cx] ' : (r.app === 'claude' ? '[CC] ' : '');
    if (pool.length) return `${appTag}池[${pool.map(nameOf).join(' | ')}] ${r.strategy}`;
    return appTag + nameOf(r.provider);
  };
  console.log('路由(请求模型名子串 → 目标 @ 模型,prio 大者先匹配;端点决定用哪组渠道):');
  for (const r of s.routes.rules)
    console.log(`  ${r.enabled ? ' ' : '#'} [p${Number(r.priority) || 0}] ${r.model ? '' : ''}${r.match || '(空)'}  →  ${targetOf(r)}${r.model ? ' @ ' + r.model : ''}`);
  console.log(`  兜底 [p${Number(s.routes.default.priority) || 0}]  →  ${targetOf(s.routes.default)}${s.routes.default.model ? ' @ ' + s.routes.default.model : ''}`);
  const cur = s.current, live = s.live, R = s.router || {};
  const modeOf = (app, lv) => lv.router ? `路由模式 ${lv.base_url}` : (lv.base_url || '(未配置)');
  console.log(`\nClaude Code 渠道 ${s.providers.claude.length} 个(当前生效 ${modeOf('claude', live.claude)},${cur.claude ? '库内选中 ' + (cur.claude === R.id ? '路由模式' : nameOf(cur.claude)) + (live.claude.match ? ' ✓' : ' ⚠配置漂移') : '库内未选中'}):`);
  for (const p of s.providers.claude)
    console.log(`  ${cur.claude === p.id ? '*' : ' '} [${p.enabled ? '启用' : '停用'}] ${p.name}  ${p.base_url}  ${p.models.join(', ') || '(未配模型)'}`);
  console.log(`\nCodex 渠道 ${s.providers.codex.length} 个(当前生效 ${modeOf('codex', live.codex)},${cur.codex ? '库内选中 ' + (cur.codex === R.id ? '路由模式' : nameOf(cur.codex)) + (live.codex.match ? ' ✓' : ' ⚠配置漂移') : '库内未选中'}):`);
  for (const p of s.providers.codex)
    console.log(`  ${cur.codex === p.id ? '*' : ' '} [${p.enabled ? '启用' : '停用'}] ${p.name}  ${p.base_url}  ${p.model} (${p.wire_api})`);
}
// 活跃对话:每个会话当前锁在哪个渠道
async function sessions() {
  let s;
  try { s = await api('/api/state'); } catch { return console.log('mixrouter 未运行或控制台不可达'); }
  const list = s.sessions || [];
  if (!list.length) return console.log('还没有活跃对话。经 127.0.0.1:8787 发起的 Claude Code / Codex 会话会出现在这里。');
  console.log(`活跃对话 ${list.length} 个(会话 TTL ${s.session_ttl_min} 分钟):\n`);
  console.log(`  ${'会话'.padEnd(12)}${'组'.padEnd(6)}${'渠道'.padEnd(20)}${'请求'.padEnd(6)}${'最近活跃'.padEnd(11)}对话`);
  for (const x of list) {
    const ago = Math.max(0, Math.round((Date.now() - x.lastUsed) / 1000));
    const seen = ago < 60 ? `${ago} 秒前` : ago < 3600 ? `${Math.floor(ago / 60)} 分前` : `${Math.floor(ago / 3600)} 小时前`;
    const prov = x.provider_name + (x.pinned ? ' ★钉定' : '');
    console.log(`  ${String(x.short).padEnd(12)}${(x.app === 'codex' ? 'Codex' : 'Claude').padEnd(6)}${prov.padEnd(20)}${String(x.reqs).padEnd(6)}${seen.padEnd(11)}${x.label || '-'}`);
  }
  // 上面两列只有**短 id**(便于和客户端显示的会话号对上),而覆盖子命令要的是**完整会话键**。
  // 所以把每一条的完整键都列出来 —— 包括还没配覆盖的新会话:第一次 set-key 用的就是它,
  // 只列"已覆盖"的那些等于新会话永远拿不到可用的键。
  console.log('\n完整会话键(覆盖子命令用这个,不是上面的短 id):');
  for (const x of list) {
    const marked = x.routing && (Object.keys(x.routing.keys || {}).length || Object.keys(x.routing.slots || {}).length);
    console.log(`  ${marked ? '*' : ' '} ${x.key}`);
  }
}
// 把客户端切到路由模式(此后流量按路由规则分发);--slots 同时按槽位表写 Claude 槽位 env
async function route(app, wire = 'anthropic', withSlots = false) {
  if (!['claude', 'codex', 'zcode'].includes(app)) return console.log(ROUTE_USAGE);
  if (app === 'zcode' && !['anthropic', 'responses', 'chat'].includes(wire)) return console.log('ZCode 协议必须为 anthropic、responses 或 chat');
  if (withSlots && app !== 'claude') return console.log('--slots 只对 claude 有意义(Codex 槽位是路由别名,客户端无需写入)');
  try {
    const r = await apiPost('/api/router/' + app, app === 'zcode' ? { wire_api: wire } : (withSlots ? { slots: true } : {}));
    const label = { claude: 'Claude Code', codex: 'Codex', zcode: 'ZCode' }[app];
    // 备份池轮换预警(/api/router 自带 warnings,渠道库那份也在里面)。
    // 池满时最老那份备份在本次写入过程中已经被清掉,只留给服务端日志等于没提示。
    for (const w of r.warnings || []) console.log(`提醒: ${w}`);
    console.log(`${app === 'zcode' ? '已注册路由接入' : '已切到路由模式'}:${label} → ${r.live.base_url}`);
    if (withSlots && Array.isArray(r.slots)) {
