{
  "_说明": "routes.json 的模板。渠道 id 必须与 providers.json 里真实存在且启用的渠道对应;指向已删除渠道的规则在写入时被拒绝,读盘时只告警,命中会 503。app 指定规则只对哪一组生效(claude = Anthropic 端点 / codex = OpenAI 端点),留空 = 两组通用。默认路由同样尊重自己的 strategy。",
  "rules": [
    {
      "_注释": "Claude 组:渠道池 + 加权 + 默认会话粘性。同一对话默认锁定一个成员;失败转移、手动改绑或会话覆盖会让它换渠道。pool 成员必须都在 claude 组。",
      "id": "r-claude-pool",
      "match": "opus, claude-3-opus",
      "provider": "",
      "model": "",
      "pool": [
        { "provider": "p1", "weight": 2, "model": "claude-opus-5[1M]" },
        { "provider": "p2", "model": "claude-opus-5[1M]" }
      ],
      "strategy": "weighted",
      "priority": 10,
      "when": {},
      "enabled": true,
      "app": "claude"
    },
    {
      "_注释": "Claude 组:单一渠道 + 附加条件(这里要求客户端 UA 含 claude-cli)。when 全部满足才命中。",
      "id": "r-claude-sonnet",
      "match": "sonnet",
      "provider": "p1",
      "model": "claude-sonnet-5",
      "pool": [],
      "strategy": "round_robin",
      "priority": 0,
      "when": { "ua": "claude-cli" },
      "enabled": true,
      "app": "claude"
    },
    {
      "_注释": "Claude 组:按对话分流,会话 id 含 vip 的走另一个渠道。先停用,按需要打开。",
      "id": "r-claude-vip",
      "match": "haiku",
      "provider": "p2",
      "model": "",
      "pool": [],
      "strategy": "round_robin",
      "priority": 0,
      "when": { "session": "vip" },
      "enabled": false,
      "app": "claude"
    },
    {
      "_注释": "Codex 组:gpt 系走 responses 直通渠道。池成员的模型不写时用渠道自己的 model。",
      "id": "r-codex-gpt",
      "match": "gpt-5",
      "provider": "",
      "model": "",
      "pool": [
        { "provider": "c1" }
      ],
      "strategy": "round_robin",
      "priority": 0,
      "when": {},
      "enabled": true,
      "app": "codex"
    },
    {
      "_注释": "Codex 组:chat 协议网关。Codex 的 responses 请求会被翻译成 chat/completions 再转发。",
      "id": "r-codex-glm",
      "match": "glm",
      "provider": "",
      "model": "",
      "pool": [
        { "provider": "c2" }
      ],
      "strategy": "round_robin",
      "priority": 0,
      "when": {},
      "enabled": true,
      "app": "codex"
    }
  ],
  "default": {
    "_注释": "兜底路由:没有规则命中时用它。这里故意留空——留空即没有目标,请求会 503 no_route_error。把它指向你实际要用的渠道,或确保上面的规则覆盖了客户端的全部模型名。一个 default 只能属于一组渠道,所以两组都要兜底时,请各写一条 app 明确的规则。",
    "provider": "",
    "model": "",
    "pool": [],
    "strategy": "round_robin",
    "app": "",
    "when": {},
    "enabled": true
  }
}
